<Slide style={{ width: 1280, height: 720, background: '#FFFFFF', flexDirection: 'column', fontFamily: 'Microsoft YaHei' }}>
    {/* A3 页眉 */}
    <Box style={{ width: 1280, height: 80, background: '#0E3F8C', padding: '0 40px', flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center' }}>
        <Text style={{ fontSize: 32, fontWeight: 'bold', color: '#FFFFFF' }}>把在途请求数真正锁住</Text>
        <Text style={{ fontSize: 16, color: '#A8C4E8' }}>02 / 系统架构与核心实现</Text>
    </Box>

    {/* C 内容区：全幅并发时序图 + 左侧骑线文字卡 */}
    <Box style={{ width: 1280, height: 580, background: '#F7F9FC', padding: '30px 0 30px 40px', flexDirection: 'row', alignItems: 'center' }}>

        {/* 骑线文字卡 */}
        <Box style={{ width: 500, height: 520, background: '#FFFFFF', borderLeft: '6px solid #1E4FA8', borderRadius: 12, boxShadow: '0 6px 24px rgba(14,63,140,0.10)', padding: 28, flexDirection: 'column' }}>
            <Text style={{ fontSize: 16, letterSpacing: 3, color: '#3D7BD9', fontWeight: 'bold' }}>核心设计 · worker.rs</Text>
            <Text style={{ fontSize: 38, fontWeight: 'bold', color: '#0E3F8C', marginTop: 14, lineHeight: 1.25 }}>从 N 个常驻循环到 Semaphore + JoinSet</Text>
            <Box style={{ width: 64, height: 4, background: '#1E4FA8', marginTop: 16 }} />
            <Text style={{ fontSize: 20, color: '#4A5568', marginTop: 16, lineHeight: 1.6 }}>重构前是 N 个常驻 worker loop，在途请求数只能靠约定；重构后每派发一个请求前先 acquire_owned() 一个 permit，permit 由 spawned task 持有，任务结束自动归还。</Text>
            <Box style={{ marginTop: 20, background: '#0E3F8C', borderRadius: 8, padding: '16px 18px' }}>
                <Text style={{ fontSize: 18, color: '#FFFFFF', lineHeight: 1.5 }}>单测断言：in-flight 峰值 ≤ permits，且至少达到 permits —— 既不超限，也不浪费槽位</Text>
            </Box>
        </Box>

        {/* 全幅并发时序图（L1 主视觉） */}
        <svg width={740} height={580} viewBox='0 0 740 580'>
            <rect x='70' y='56' width='640' height='52' rx='10' fill='#E8EFF8' stroke='#C9DDF6' strokeWidth='1' />
            <text x='390' y='89' textAnchor='middle' fontSize='19' fill='#1E4FA8'>dispatcher：每派发一个请求前先 acquire_owned()</text>

            <line x1='160' y1='108' x2='160' y2='148' stroke='#3D7BD9' strokeWidth='2' />
            <line x1='330' y1='108' x2='330' y2='148' stroke='#3D7BD9' strokeWidth='2' />
            <line x1='500' y1='108' x2='500' y2='148' stroke='#3D7BD9' strokeWidth='2' />
            <line x1='670' y1='108' x2='670' y2='148' stroke='#3D7BD9' strokeWidth='2' />

            <rect x='70' y='148' width='640' height='66' rx='10' fill='#FFFFFF' stroke='#D6DCE5' strokeWidth='1' />
            <text x='94' y='188' fontSize='18' fill='#8B97A8'>P1</text>
            <rect x='140' y='163' width='150' height='36' rx='6' fill='#3D7BD9' />
            <rect x='300' y='163' width='110' height='36' rx='6' fill='#C9DDF6' />
            <rect x='420' y='163' width='180' height='36' rx='6' fill='#3D7BD9' />

            <rect x='70' y='236' width='640' height='66' rx='10' fill='#FFFFFF' stroke='#D6DCE5' strokeWidth='1' />
            <text x='94' y='276' fontSize='18' fill='#8B97A8'>P2</text>
            <rect x='140' y='251' width='100' height='36' rx='6' fill='#C9DDF6' />
            <rect x='250' y='251' width='170' height='36' rx='6' fill='#3D7BD9' />
            <rect x='430' y='251' width='170' height='36' rx='6' fill='#C9DDF6' />

            <rect x='70' y='324' width='640' height='66' rx='10' fill='#FFFFFF' stroke='#D6DCE5' strokeWidth='1' />
            <text x='94' y='364' fontSize='18' fill='#8B97A8'>P3</text>
            <rect x='140' y='339' width='190' height='36' rx='6' fill='#3D7BD9' />
            <rect x='340' y='339' width='130' height='36' rx='6' fill='#C9DDF6' />
            <rect x='480' y='339' width='120' height='36' rx='6' fill='#3D7BD9' />

            <rect x='70' y='412' width='640' height='66' rx='10' fill='#FFFFFF' stroke='#D6DCE5' strokeWidth='1' />
            <text x='94' y='452' fontSize='18' fill='#8B97A8'>P4</text>
            <rect x='140' y='427' width='120' height='36' rx='6' fill='#C9DDF6' />
            <rect x='270' y='427' width='200' height='36' rx='6' fill='#3D7BD9' />
            <rect x='480' y='427' width='120' height='36' rx='6' fill='#C9DDF6' />

            <line x1='70' y1='500' x2='710' y2='500' stroke='#D6DCE5' strokeWidth='1' />
            <text x='70' y='530' fontSize='19' fill='#1E4FA8'>任一时刻被占用的槽位 ≤ concurrency</text>
            <text x='70' y='558' fontSize='19' fill='#8B97A8'>任务结束时 permit 由 RAII 自动归还</text>
        </svg>
    </Box>

    {/* D 页脚 */}
    <Box style={{ width: 1280, height: 60, padding: '0 40px', flexDirection: 'row', justifyContent: 'space-between', alignItems: 'center', borderTop: '1px solid #E5E7EB' }}>
        <Text style={{ fontSize: 14, color: '#8B97A8' }}>Rust HTTP 压测工具 · 项目答辩</Text>
        <Text style={{ fontSize: 16, fontWeight: 'bold', color: '#1E4FA8' }}>08 / 18</Text>
    </Box>
</Slide>
